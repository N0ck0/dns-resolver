#!/usr/bin/env -S python3 -u

import random
import argparse, socket, time, json, select, struct, sys, math
from dnslib import DNSRecord, DNSHeader, RR, QTYPE, A, CNAME, NS, MX, TXT, RCODE

class Server:
    def __init__(self, root_ip, zone_file, port):
        self.root_ip = root_ip

        self.socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.socket.bind(("0.0.0.0", port))
        self.port = self.socket.getsockname()[1]

        self.origin = ""
        self.TIMEOUT = 2
        self.zone = {}
        self.TTL = 67
        self.cache = {
            #cache[(domain, q_type)] -> {[records], expires_at}
        }
        self.pending ={
            # pending[new_txid] = {
            # "client_addr": addr,
            # "client_txid": original_txid,
            # "original_request": request,
            # "current_server": "root_ip",
            # "q_domain": "www.google.com.",
            # "q_type": QTYPE.A,
            # "time": 6.7 seconds
            # }
        }

        zone_text = open(zone_file).read()
        for record in RR.fromZone(zone_text):
            record_key = (str(record.rname).lower(), record.rtype)
            self.zone.setdefault(record_key, []).append(record)
            if record.rtype == QTYPE.SOA:
                self.origin = str(record.rname).lower()
                self.TTL = record.ttl

        self.log("Bound to port %d" % self.port)

    def log(self, message):
        sys.stderr.write(message + "\n")
        sys.stderr.flush()

    def send(self, addr, message):
        self.log("Sending message:\n%s" % message)
        message.header.rd = 1
        self.socket.sendto(message.pack(), addr)

    def send_error(self, addr, request, error_code):
        self.log("Sending Error...")
        resp = request.reply()
        resp.header.rcode = error_code
        resp.header.ra = 1
        self.send(addr, resp)

    def recv(self, socket):
        data, addr = socket.recvfrom(65535)

        # Unpack the DNS request
        try:
            request = DNSRecord.parse(data)
        except:
            self.log("Invalid packet... Dropping")
            return
        
        self.log("Received message:\n%s" % request)
        if request.header.id in self.pending:
            #upstream response
            self.handle_upstream_response(request)
        elif request.header.get_qr() == 0:  
            self.handle_query(addr, request)
        else:
            #unexpected response
            return


    def handle_query(self, addr, request):

        if len(request.questions) != 1:
            self.send_error(addr, request, RCODE.SERVFAIL)
            return
        
        query = request.questions[0]
        query_domain = str(query.qname).lower()
        query_type = query.qtype
        wants_recursion = request.header.get_rd()

        if query_domain == self.origin or query_domain.endswith("." + self.origin):
            #under our domain
            self.handle_authoritative(addr, request, query_domain, query_type)
        else:
            #not under our auth: recurse or error
            if not wants_recursion:
                self.send_error(addr, request, RCODE.SERVFAIL)
                return
            self.handle_recursive(addr, request, query_domain, query_type)


    def handle_recursive(self, addr, request, q_domain, q_type):
        #check for cached answer to query
        cached = self.get_cache(q_domain, q_type)
        if cached:
            entry = self.cache.get((q_domain, q_type))
            reply = request.reply()
            reply.header.ra = 1
            reply.header.aa = 0
            remaining_ttl = max(1, int(entry["expires_at"] - time.time()))
            for rr in cached:
                #response should have updated ttl
                rr.ttl = remaining_ttl
                reply.add_answer(rr)
            # if NS query, include glue from cache
            if q_type == QTYPE.NS:
                for ns_rr in cached:
                    ns_target = str(ns_rr.rdata.label).lower()
                    glue = self.get_cache(ns_target, QTYPE.A)
                    if glue:
                        for a_rr in glue:
                            a_rr.ttl = remaining_ttl
                            reply.add_ar(a_rr)
            self.send(addr, reply)
            return

        #find best starting point
        start_ip, start_bailiwick = self.find_best_nameserver(q_domain)

        ques = request.questions[0]
        new_id = self.add_pending_entry(addr, request, q_domain, q_type)
        self.pending[new_id]["bailiwick"] = start_bailiwick

        upstream_query = DNSRecord.question(str(ques.qname), QTYPE[ques.qtype])
        upstream_query.header.id = new_id
        upstream_query.header.rd = 0
        self.send((start_ip, 60053), upstream_query)

    def handle_upstream_response(self, response):
        p = self.pending.pop(response.header.id)
        response.header.tc = 0
        bailiwick = p["bailiwick"]
        trusted_answers = self.filter_bailiwick(response.rr, bailiwick)
        trusted_auth = self.filter_bailiwick(response.auth, bailiwick)
        trusted_ar = self.filter_bailiwick(response.ar, bailiwick)

        all_answers = p.get("partial_answer", []) + list(trusted_answers)

        if response.header.rcode == RCODE.NOERROR:
            #aggressive caching
            self.cache_records(trusted_answers)
            self.cache_records(trusted_ar)
            self.cache_records(trusted_auth)

        #got full answer
        if response.header.rcode == RCODE.NOERROR and len(response.rr) > 0:
            if len(trusted_answers) > 0:
                if p["q_type"] == QTYPE.A:
                    last_rr = all_answers[-1]
                    if last_rr.rtype == QTYPE.CNAME:
                        #unresolved answer
                        cname_target = str(last_rr.rdata.label).lower()
                        new_id = self.add_pending_entry(
                            p["client_addr"], p["original_request"], cname_target, QTYPE.A
                        )
                        #record what has been found so far
                        self.pending[new_id]["partial_answer"] = all_answers
                        
                        start_ip, start_bailiwick = self.find_best_nameserver(cname_target)
                        self.pending[new_id]["bailiwick"] = start_bailiwick
                        upstream_query = DNSRecord.question(cname_target, "A")
                        upstream_query.header.id = new_id
                        upstream_query.header.rd = 0
                        self.send((start_ip, 60053), upstream_query)
                        return              

                reply = p["original_request"].reply()
                reply.header.ra = 1
                reply.header.aa = 0
                reply.header.tc = 0
                for rr in all_answers:
                    reply.add_answer(rr)
                for rr in trusted_ar:  # add this
                    reply.add_ar(rr)
                self.send(p["client_addr"], reply)
                return
            else:
                #received answers but not trusted (ans outside bailiwick)
                reply = p["original_request"].reply()
                reply.header.ra = 1
                reply.header.aa = 0
                self.send(p["client_addr"], reply)
                return
        
        #received NS answer in auth section
        if response.header.rcode == RCODE.NOERROR and p["q_type"] == QTYPE.NS:
            auth_for_query = [record for record in trusted_auth 
                            if str(record.rname).lower() == p["q_domain"] 
                            and record.rtype == QTYPE.NS]
            if auth_for_query:
                reply = p["original_request"].reply()
                reply.header.ra = 1
                reply.header.aa = 0
                reply.header.tc = 0
                for rr in auth_for_query:
                    #answer with NS records
                    reply.add_answer(rr)
                for rr in trusted_ar:
                    #include glue A records
                    reply.add_ar(rr)
                self.send(p["client_addr"], reply)
                return

        #received error
        if response.header.rcode in (RCODE.NXDOMAIN, RCODE.SERVFAIL):
            reply = p["original_request"].reply()
            reply.header.rcode = response.header.rcode
            reply.header.ra = 1
            reply.header.aa = 0
            reply.header.tc = 0
            self.send(p["client_addr"], reply)
            return

        #follow referral
        next_ip = None
        for ar in trusted_ar:
            if ar.rtype == QTYPE.A:
                next_ip = str(ar.rdata)
                break
        
        if next_ip == None and len(response.ar) > 0:
            #bailiwick failure
            reply = p["original_request"].reply()
            reply.header.ra = 1
            reply.header.aa = 0
            self.send(p["client_addr"], reply)
            return

        if next_ip is None:
            #can't follow
            self.send_error(p["client_addr"], p["original_request"], RCODE.SERVFAIL)
            return

        #follow hierarchy
        new_id = self.add_pending_entry(
            p["client_addr"], p["original_request"], p["q_domain"], p["q_type"]
        )
        if "partial_answer" in p:
            self.pending[new_id]["partial_answer"] = p["partial_answer"]
        new_bailiwick = self.get_bailiwick(response)
        if new_bailiwick:
            self.pending[new_id]["bailiwick"] = new_bailiwick
        upstream_query = DNSRecord.question(p["q_domain"], QTYPE[p["q_type"]])
        upstream_query.header.id = new_id
        upstream_query.header.rd = 0
        self.send((next_ip, 60053), upstream_query)


    def add_pending_entry(self, addr, request, q_domain, q_type):
            # pending[new_txid] = {
            # "client_addr": addr,
            # "client_txid": original_txid,
            # "original_request": request,
            # "current_server": "root_ip",
            # "q_domain": "www.google.com.",
            # "q_type": QTYPE.A,
            # "time": 6.7 seconds
            # "bailiwick": ".foo."
            # }
            while True:
                new_id = random.randint(0, 60000)
                if new_id not in self.pending:
                    break

            self.pending[new_id] = {
                "client_addr": addr,
                "client_txid": request.header.id,
                "original_request": request,
                "current_server": self.root_ip,
                "q_domain": q_domain,
                "q_type": q_type,
                "time": time.time(),
                "bailiwick": "."
            }

            return new_id
        
    def cache_records(self, rr_list):
        groups = {}
        for rr in rr_list:
            if rr.ttl <= 0:
                continue
            key = (str(rr.rname).lower(), rr.rtype)
            groups.setdefault(key, []).append(rr)
        
        #use min ttl
        for key, records in groups.items():
            min_ttl = min(rr.ttl for rr in records)
            expires = time.time() + min_ttl
            existing = self.cache.get(key)
            if not existing or expires >= existing["expires_at"]:
                self.cache[key] = {"records": records, "expires_at": expires}

    def get_cache(self, domain, qtype):
        key = (domain.lower(), qtype)
        entry = self.cache.get(key)
        if not entry:
            return None
        if time.time() >= entry["expires_at"]:
            del self.cache[key]
            return None
        return entry["records"]
    
    #returns best_ip, ns_bailiwick
    def find_best_nameserver(self, q_domain):
        #walk up labels looking for cache hit
        labels = q_domain.rstrip('.').split('.')
        for i in range(1, len(labels)):
            candidate = '.'.join(labels[i:]) + '.'
            ns_records = self.get_cache(candidate, QTYPE.NS)
            if ns_records:
                #got cache hit, look for ns A record to query
                for ns_rr in ns_records:
                    ns_target = str(ns_rr.rdata.label).lower()
                    a_records = self.get_cache(ns_target, QTYPE.A)
                    if a_records:
                        ns_ip = str(a_records[0].rdata)
                        return ns_ip, candidate  # ip, bailiwick
        #not cached, begin from root
        return self.root_ip, "."
       

    def handle_authoritative(self, addr, request, q_domain, q_type):
        reply = request.reply()
        reply.header.aa = 1
        reply.header.ra = 1

        records = self.zone.get((q_domain, q_type))
        
        if records:
            for record in records:
                reply.add_answer(record)

            #add glue records
            if q_type == QTYPE.NS:
                for ns_record in records:
                    ns_target = str(ns_record.rdata.label).lower()
                    glue = self.zone.get((ns_target, QTYPE.A), [])
                    for record in glue:
                        reply.add_ar(record)
            self.send(addr, reply)
            return
        
        #client asked for A/AAAA but only have CNAME record
        if q_type == QTYPE.A or q_type == QTYPE.AAAA:
            cname_records = self.zone.get((q_domain, QTYPE.CNAME), [])
            if cname_records:
                for record in cname_records:
                    reply.add_answer(record)

                #CNAME domain name
                target = str(cname_records[0].rdata.label).lower()
                target_records = self.zone.get((target, q_type), [])
                for record in target_records:
                    reply.add_answer(record)
                self.send(addr, reply)
                return
        
        #delegation checking
        ns_name, delegation = self.get_delegation(q_domain)
        if delegation:
            reply.header.aa = 0
            for dele in delegation:
                reply.add_auth(dele)
            
            for ns_record in delegation:
                ns_target = str(ns_record.rdata.label).lower()
                glue = self.zone.get((ns_target, QTYPE.A), [])
                for record in glue:
                    reply.add_ar(record)

            self.send(addr, reply)
            return

        reply.header.rcode = RCODE.NXDOMAIN
        self.send(addr, reply)


    def get_delegation(self, q_domain):
        parts = q_domain.rstrip('.').split('.')
        for i in range(1, len(parts)):
            candidate = '.'.join(parts[i:]) + '.'
            if candidate == self.origin:
                break  # don't delegate to ourselves
            records = self.zone.get((candidate, QTYPE.NS))
            if records:
                return candidate, records
        return None, None
    
    def in_bailiwick(self, name, bailiwick):
        if bailiwick == ".":
            return True  #root is authoritative for everything
        name = name.rstrip('.')
        bailiwick = bailiwick.rstrip('.')
        return name == bailiwick or name.endswith('.' + bailiwick)
    
    def get_bailiwick(self, response):
        for record in response.auth:
            if record.rtype == QTYPE.NS:
                return str(record.rname).lower()
        return None
    
    def filter_bailiwick(self, records, bailiwick):
        return [rr for rr in records if self.in_bailiwick(str(rr.rname).lower(), bailiwick)]
    
    def check_timeouts(self):
        now = time.time()
        expired = [txid for txid, p in self.pending.items()
                if now - p["time"] > self.TIMEOUT]
        for txid in expired:
            p = self.pending.pop(txid)
            self.send_error(p["client_addr"], p["original_request"], RCODE.SERVFAIL)


    def run(self):
        seq = 0
        while True:
            socks = select.select([self.socket], [], [], 0.1)[0]
            for conn in socks:
                self.recv(conn)
            self.check_timeouts()

        return

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description='send data')
    parser.add_argument('root_ip', type=str, help="The IP address of the root server")
    parser.add_argument('zone', type=str, help="The zone file for this server")
    parser.add_argument('--port', type=int, help="The port this server should bind to", default=0)
    args = parser.parse_args()
    sender = Server(args.root_ip, args.zone, args.port)
    sender.run()
